# Copy to .env.local and fill in values.

# Боевой адрес сайта (canonical, Open Graph, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://example.com

# SMTP (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-user
SMTP_PASS=your-password
BOOKING_FROM_EMAIL=retreat@example.com
BOOKING_NOTIFY_EMAIL=you@example.com

# Telegram Bot API (уведомления о заявках)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# Публичный @ник организатора на сайте (без @)
NEXT_PUBLIC_ORGANIZER_TELEGRAM=your_username
